NODE_ENV=production
PORT=3001

# API Configuration
# IMPORTANT: Set FOOTYSTATS_API_KEY as environment variable on your server
# FOOTYSTATS_API_KEY=your_api_key_here_DO_NOT_COMMIT
FOOTYSTATS_BASE_URL=https://api.football-data-api.com
API_TIMEOUT=15000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000
API_DEFAULT_MATCH_LIMIT=20
API_DEFAULT_H2H_LIMIT=10
API_MAX_BATCH_SIZE=10
API_MIN_REQUEST_DELAY=200

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_DEFAULT_TTL=3600000
CACHE_TEAM_DATA_TTL=7200000
CACHE_MATCH_DATA_TTL=1800000
CACHE_STATISTICS_TTL=900000
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=300000
CACHE_LIVE_DATA_TTL=60000
CACHE_ENABLED=true

# Redis Configuration
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT=5000
REDIS_MAX_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY_BASE=100
REDIS_MAX_RETRY_DELAY=3000

# Logging Configuration
LOG_LEVEL=info
LOG_MAX_FILES=5

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=*
CORS_MAX_AGE=86400

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_COLLECTION_INTERVAL=10000

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
COMPRESSION_MEMORY_LEVEL=8