# FootyStats API Configuration
FOOTYSTATS_API_KEY=your_api_key_here
FOOTYSTATS_BASE_URL=https://api.football-data-api.com

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_URL=./data/football.db

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Rate Limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Cache Configuration
CACHE_TTL=300
PREDICTION_CACHE_TTL=1800

# Algorithm Configuration
PREDICTION_CONFIDENCE_THRESHOLD=0.65
HISTORICAL_MATCHES_LIMIT=10
FORM_MATCHES_LIMIT=5