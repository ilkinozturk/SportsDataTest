# FootyStats API Configuration
FOOTYSTATS_API_KEY=your_api_key_here
FOOTYSTATS_BASE_URL=https://api.football-data-api.com

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Configuration
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Strict CORS origins for sensitive endpoints
STRICT_ORIGINS=https://admin.yourdomain.com

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379
# Or use separate host/port
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# API Keys for different services (if needed)
GOOGLE_API_KEY=your_google_api_key
SENTRY_DSN=your_sentry_dsn_here

# Database (if you add one later)
DATABASE_URL=postgresql://user:password@localhost:5432/sportsdata