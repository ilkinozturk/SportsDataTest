# SportsData.AI Environment Configuration
# Copy this file to .env and update with your values

# ===========================
# Environment
# ===========================
NODE_ENV=development

# ===========================
# Server Configuration
# ===========================
PORT=3001

# ===========================
# API Configuration
# ===========================
# FootyStats API credentials
FOOTYSTATS_API_KEY=your_api_key_here
FOOTYSTATS_BASE_URL=https://api.footystats.org/v1

# API request settings
API_TIMEOUT=15000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000
API_DEFAULT_MATCH_LIMIT=20
API_DEFAULT_H2H_LIMIT=10
API_MAX_BATCH_SIZE=10
API_MIN_REQUEST_DELAY=200

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL=false
RATE_LIMIT_SKIP_FAILED=false

# ===========================
# Cache Configuration
# ===========================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600000
CACHE_TEAM_DATA_TTL=7200000
CACHE_MATCH_DATA_TTL=1800000
CACHE_STATISTICS_TTL=900000
CACHE_MAX_SIZE=1000
CACHE_CLEANUP_INTERVAL=300000
CACHE_LIVE_DATA_TTL=60000

# ===========================
# Redis Configuration (Optional)
# ===========================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
# Or use separate host/port
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECTION_TIMEOUT=5000
REDIS_MAX_RETRY_ATTEMPTS=3
REDIS_RETRY_DELAY_BASE=100
REDIS_MAX_RETRY_DELAY=3000

# ===========================
# Logging Configuration
# ===========================
LOG_LEVEL=info
LOG_PRETTY_PRINT=true
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILE_SIZE=10mb
LOG_MAX_FILES=5

# ===========================
# CORS Configuration
# ===========================
CORS_ENABLED=true
# Comma-separated list or single origin (* for all)
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ===========================
# Security
# ===========================
HELMET_ENABLED=true
TRUST_PROXY=false
SESSION_SECRET=change-this-secret-in-production-minimum-32-characters

# ===========================
# Monitoring
# ===========================
PROMETHEUS_ENABLED=true
METRICS_PATH=/metrics
COLLECT_DEFAULT_METRICS=true
HEALTH_CHECK_PATH=/health
METRICS_COLLECTION_INTERVAL=10000

# ===========================
# Compression
# ===========================
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
COMPRESSION_MEMORY_LEVEL=8

# ===========================
# External Services (Optional)
# ===========================
# Sentry error tracking
SENTRY_DSN=

# Database (if you add one later)
DATABASE_URL=postgresql://user:password@localhost:5432/sportsdata