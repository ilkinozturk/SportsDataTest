{
  "name": "footystats-prediction-engine",
  "version": "1.0.0",
  "description": "Modern football match analysis and prediction system using FootyStats API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec ts-node src/server/index.ts",
    "client:dev": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "build:ts": "tsc",
    "watch:ts": "tsc --watch",
    "start": "node dist/server.js",
    "setup": "npm install && cd client && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:all": "jest --coverage --runInBand",
    "lint": "eslint . --ext .js,.ts --ignore-pattern '*.json' --ignore-pattern 'test-*.js' --ignore-pattern 'old-tests/' --ignore-pattern 'old-data/' --fix",
    "lint:check": "eslint . --ext .js,.ts --ignore-pattern '*.json' --ignore-pattern 'test-*.js' --ignore-pattern 'old-tests/' --ignore-pattern 'old-data/'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "code-quality": "npm run lint:check && npm run format:check && npm run type-check",
    "fix": "npm run lint && npm run format",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "start:js": "npx nodemon simple-server-optimized.js",
    "start:auto": "npx nodemon --watch . --ignore node_modules --ignore logs --ext js,ts,html,json simple-server-optimized.js",
    "start:daemon": "npx pm2 start simple-server-optimized.js --name sportsdata-ai --watch",
    "prepare": "husky",
    "hooks:install": "husky install",
    "hooks:pre-commit": "lint-staged",
    "hooks:test": "echo 'Testing pre-commit hooks...' && npm run hooks:pre-commit",
    "migrate:ts": "node scripts/migrate-to-typescript.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "redis": "^4.6.11",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.10",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.19.2",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "football",
    "soccer",
    "prediction",
    "statistics",
    "footystats",
    "machine-learning",
    "betting",
    "analysis"
  ],
  "author": "FootyStats Prediction Engine",
  "license": "MIT"
}
