{
  "name": "footystats-prediction-engine",
  "version": "1.0.0",
  "description": "Modern football match analysis and prediction system using FootyStats API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "webpack serve --mode development --open",
    "dev:server": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec ts-node src/server/index.ts",
    "client:dev": "cd client && npm run dev",
    "build": "webpack --mode production",
    "build:analyze": "ANALYZE=true webpack --mode production",
    "build:stats": "webpack --mode production --json > dist/stats.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "build:ts": "tsc",
    "watch": "webpack --mode development --watch",
    "watch:ts": "tsc --watch",
    "start": "node dist/server.js",
    "setup": "npm install && cd client && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:all": "jest --coverage --runInBand",
    "lint": "eslint public/js/**/*.js --fix",
    "lint:check": "eslint public/js/**/*.js",
    "format": "prettier --write \"public/js/**/*.js\"",
    "format:check": "prettier --check \"public/js/**/*.js\"",
    "code-quality": "npm run lint:check && npm run format:check && npm run type-check",
    "fix": "npm run lint && npm run format",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "start:js": "npx nodemon simple-server-optimized.js",
    "start:auto": "npx nodemon --watch . --ignore node_modules --ignore logs --ext js,ts,html,json simple-server-optimized.js",
    "start:daemon": "npx pm2 start simple-server-optimized.js --name sportsdata-ai --watch",
    "prepare": "husky",
    "hooks:install": "husky install",
    "hooks:pre-commit": "lint-staged",
    "hooks:test": "echo 'Testing pre-commit hooks...' && npm run hooks:pre-commit",
    "migrate:ts": "node scripts/migrate-to-typescript.js",
    "clean": "rimraf public/dist",
    "prebuild": "npm run clean",
    "postbuild": "npm run build:stats"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "axios": "^1.10.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.3",
    "redis": "^4.6.11",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.10",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.23.0",
    "@types/axios": "^0.14.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.14.202",
    "@types/node": "^20.19.2",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "autoprefixer": "^10.4.16",
    "babel-loader": "^9.1.3",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.2",
    "mini-css-extract-plugin": "^2.7.6",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "prettier": "^3.6.2",
    "react-refresh": "^0.14.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.3",
    "supertest": "^7.1.1",
    "terser-webpack-plugin": "^5.3.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "football",
    "soccer",
    "prediction",
    "statistics",
    "footystats",
    "machine-learning",
    "betting",
    "analysis"
  ],
  "author": "FootyStats Prediction Engine",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "!src/config.js",
      "!src/**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js"
    ],
    "moduleFileExtensions": ["js", "json"],
    "transform": {},
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testTimeout": 10000,
    "clearMocks": true,
    "restoreMocks": true
  }
}
