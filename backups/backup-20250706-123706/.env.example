# SportsData.AI Environment Configuration Example
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control!

# Environment
NODE_ENV=development
PORT=3001

# API Configuration
# Get your API key from https://footystats.org/api/documentation
FOOTYSTATS_API_KEY=your_api_key_here_DO_NOT_COMMIT
FOOTYSTATS_BASE_URL=https://api.football-data-api.com

# API Settings
API_TIMEOUT=15000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000
API_DEFAULT_MATCH_LIMIT=20
API_DEFAULT_H2H_LIMIT=10

# Session Secret (generate a random string for production)
SESSION_SECRET=your-secret-key-here-minimum-32-characters

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600000
CACHE_TEAM_DATA_TTL=7200000
CACHE_MATCH_DATA_TTL=1800000

# Redis Configuration (optional)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=5

# CORS Configuration
CORS_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_COLLECTION_INTERVAL=10000